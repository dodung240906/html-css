-- HỆ THỐNG CHO THUÊ XE AUTORIDE
CREATE DATABASE IF NOT EXISTS AutoRideDB;
USE AutoRideDB;

-- 1. Bảng Khách hàng
CREATE TABLE KhachHang (
    MaKH VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    SoDienThoai VARCHAR(15) UNIQUE NOT NULL,
    Email VARCHAR(100) UNIQUE,
    SoGiaiPhepLaiXe VARCHAR(20) UNIQUE NOT NULL
);

-- 2. Bảng Xe
CREATE TABLE Xe (
    MaXe VARCHAR(10) PRIMARY KEY,
    BienSo VARCHAR(15) UNIQUE NOT NULL,
    TenXe VARCHAR(100) NOT NULL,
    LoaiXe VARCHAR(50),
    GiaThueTheoGio DECIMAL(10, 2) NOT NULL,
    TrangThai ENUM('Available', 'Rented', 'Maintenance', 'Inspection_Required') DEFAULT 'Available'
);

-- 3. Bảng Chuyến đi / Đơn thuê xe
CREATE TABLE ChuyenDi (
    MaChuyen INT AUTO_INCREMENT PRIMARY KEY,
    MaKH VARCHAR(10),
    MaXe VARCHAR(10),
    ThoiGianBatDau DATETIME NOT NULL,
    ThoiGianKetThuc DATETIME,
    TongTien DECIMAL(12, 2) DEFAULT 0.00,
    TrangThaiThanhToan ENUM('Pending', 'Paid', 'Cancelled') DEFAULT 'Pending',
    FOREIGN KEY (MaKH) REFERENCES KhachHang(MaKH) ON DELETE CASCADE,
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe) ON DELETE CASCADE
);

-- 4. Bảng Bảo trì xe (BaoTri)
CREATE TABLE BaoTri (
    MaBaoTri INT AUTO_INCREMENT PRIMARY KEY,
    MaXe VARCHAR(10),
    NgayBaoTri DATE NOT NULL,
    ChiPhi DECIMAL(10, 2) DEFAULT 0.00,
    MoTa VARCHAR(255),
    TrangThaiBaoTri ENUM('Scheduled', 'In_Progress', 'Completed') DEFAULT 'Scheduled',
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe) ON DELETE CASCADE
);

-- 5. Bảng Inspections (Kiểm tra xe)
CREATE TABLE Inspections (
    InspectionID INT AUTO_INCREMENT PRIMARY KEY,
    MaXe VARCHAR(10) NOT NULL,
    InspectionDate DATETIME DEFAULT CURRENT_TIMESTAMP,
    InspectorName VARCHAR(100) NOT NULL,
    ConditionStatus ENUM('Good', 'Needs_Repair', 'Critical') DEFAULT 'Good',
    Notes TEXT,
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe) ON DELETE CASCADE
);

