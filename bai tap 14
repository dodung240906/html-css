-- HỆ THỐNG SMARTFACTORY - THIẾT KẾ LEAN INDEX CÂN BẰNG HIỆU NĂNG READ/WRITE
CREATE DATABASE IF NOT EXISTS smartfactory_db;
USE smartfactory_db;

-- 1. Khởi tạo cấu trúc bảng SensorLogs
DROP TABLE IF EXISTS SensorLogs;
CREATE TABLE SensorLogs (
    log_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    sensor_id INT NOT NULL,
    recorded_at DATETIME NOT NULL,
    temperature DECIMAL(5,2),
    humidity DECIMAL(5,2),
    status VARCHAR(20) -- 'NORMAL', 'WARNING', 'CRITICAL'
);

-- ========================================================
-- PHẦN 1: TẠO "FAT COVERING INDEX" BAN ĐẦU (GÂY THẢM HỌA WRITE & DISK)
-- ========================================================
CREATE INDEX idx_fat_covering ON SensorLogs(sensor_id, recorded_at, temperature, humidity, status);

-- Kiểm tra kế hoạch thực thi khi dùng Fat Index (Trả về "Using index" ở cột Extra)
EXPLAIN SELECT temperature, humidity, status 
FROM SensorLogs 
WHERE sensor_id = 105 AND recorded_at >= '2026-06-20 00:00:00';

-- ========================================================
-- PHẦN 2: THỰC HIỆN "PHẪU THUẬT" TỐI ƯU HÓA (RE-INDEXING)
-- ========================================================
-- Bước 2.1: Xóa bỏ Fat Index khổng lồ gây nghẽn luồng GHI (INSERT)
ALTER TABLE SensorLogs DROP INDEX idx_fat_covering;

-- Bước 2.2: Tạo Lean Index tinh gọn chỉ phục vụ Lọc (WHERE) và Sắp xếp (ORDER BY)
CREATE INDEX idx_lean_search ON SensorLogs(sensor_id, recorded_at);

-- ========================================================
-- PHẦN 3: ĐỐI CHIẾU VÀ XÁC MINH KẾT QUẢ VẬN HÀNH (AFTER)
-- ========================================================
-- Kiểm tra lại EXPLAIN: 
-- Cột 'key' nhận dạng thành công 'idx_lean_search', 'type' đạt 'range'.
-- Cột 'Extra' không còn 'Using index' (do cần Lookup về Table lấy temperature, humidity), 
-- nhưng tốc độ INSERT tăng gấp nhiều lần và dung lượng Index giảm hơn 70%.
EXPLAIN SELECT temperature, humidity, status 
FROM SensorLogs 
WHERE sensor_id = 105 AND recorded_at >= '2026-06-20 00:00:00';

-- Kiểm tra thống kê dung lượng Data và Index
SELECT 
    table_name AS 'Table',
    ROUND(data_length / 1024 / 1024, 2) AS 'Data Size (MB)',
    ROUND(index_length / 1024 / 1024, 2) AS 'Index Size (MB)',
    ROUND((data_length + index_length) / 1024 / 1024, 2) AS 'Total Size (MB)'
FROM information_schema.TABLES
WHERE table_schema = 'smartfactory_db' AND table_name = 'SensorLogs';
