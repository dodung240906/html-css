-- CƠ SỞ DỮ LIỆU QUẢN LÝ BÁN HÀNG
CREATE DATABASE IF NOT EXISTS QuanLyBanHang;
USE QuanLyBanHang;

-- 1. Bảng Customer (Khách hàng)
CREATE TABLE Customer (
    cID INT AUTO_INCREMENT PRIMARY KEY,
    cName VARCHAR(100) NOT NULL,
    cAge INT
);

-- 2. Bảng Product (Sản phẩm)
CREATE TABLE Product (
    pID INT AUTO_INCREMENT PRIMARY KEY,
    pName VARCHAR(150) NOT NULL,
    pPrice INT NOT NULL
);

-- 3. Bảng Order (Đơn hàng)
CREATE TABLE `Order` (
    oID INT AUTO_INCREMENT PRIMARY KEY,
    cID INT,
    oDate DATETIME DEFAULT CURRENT_TIMESTAMP,
    oTotalPrice INT,
    FOREIGN KEY (cID) REFERENCES Customer(cID) ON DELETE CASCADE
);

-- 4. Bảng Orderdetail (Chi tiết đơn hàng)
CREATE TABLE Orderdetail (
    oID INT,
    pID INT,
    odQTY INT NOT NULL CHECK (odQTY > 0),
    PRIMARY KEY (oID, pID),
    FOREIGN KEY (oID) REFERENCES `Order`(oID) ON DELETE CASCADE,
    FOREIGN KEY (pID) REFERENCES Product(pID) ON DELETE CASCADE
);

