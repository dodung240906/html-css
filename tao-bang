-- 1. Tạo CSDL
CREATE DATABASE IF NOT EXISTS QuanLyHocSinh;
USE QuanLyHocSinh;

-- 2. Tạo bảng Giáo Viên (GiaoVien)
CREATE TABLE GiaoVien (
    MaGV VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    NgaySinh DATE,
    GioiTinh VARCHAR(5),
    SoDienThoai VARCHAR(15),
    Email VARCHAR(100) UNIQUE
);

-- 3. Tạo bảng Lớp Học (LopHoc) - Có giáo viên chủ nhiệm
CREATE TABLE LopHoc (
    MaLop VARCHAR(10) PRIMARY KEY,
    TenLop VARCHAR(50) NOT NULL,
    NamHoc VARCHAR(20) NOT NULL,
    MaGVCN VARCHAR(10),
    FOREIGN KEY (MaGVCN) REFERENCES GiaoVien(MaGV) ON DELETE SET NULL
);

-- 4. Tạo bảng Học Sinh (HocSinh)
CREATE TABLE HocSinh (
    MaHS VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    NgaySinh DATE,
    GioiTinh VARCHAR(5),
    DiaChi VARCHAR(255),
    MaLop VARCHAR(10),
    FOREIGN KEY (MaLop) REFERENCES LopHoc(MaLop) ON DELETE SET NULL
);

-- 5. Tạo bảng Môn Học (MonHoc) - Phân công giáo viên phụ trách môn
CREATE TABLE MonHoc (
    MaMon VARCHAR(10) PRIMARY KEY,
    TenMon VARCHAR(100) NOT NULL,
    SoTiet INT DEFAULT 45,
    MaGVPhuTrach VARCHAR(10),
    FOREIGN KEY (MaGVPhuTrach) REFERENCES GiaoVien(MaGV) ON DELETE SET NULL
);

-- 6. Tạo bảng Bảng Điểm (BangDiem)
CREATE TABLE BangDiem (
    MaHS VARCHAR(10),
    MaMon VARCHAR(10),
    HocKy INT NOT NULL CHECK (HocKy IN (1, 2)),
    DiemMieng FLOAT CHECK (DiemMieng BETWEEN 0 AND 10),
    Diem15Phut FLOAT CHECK (Diem15Phut BETWEEN 0 AND 10),
    Diem1Tiet FLOAT CHECK (Diem1Tiet BETWEEN 0 AND 10),
    DiemThi FLOAT CHECK (DiemThi BETWEEN 0 AND 10),
    PRIMARY KEY (MaHS, MaMon, HocKy),
    FOREIGN KEY (MaHS) REFERENCES HocSinh(MaHS) ON DELETE CASCADE,
    FOREIGN KEY (MaMon) REFERENCES MonHoc(MaMon) ON DELETE CASCADE
);

