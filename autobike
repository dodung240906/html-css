-- HỆ THỐNG CHO THUÊ XE AUTORIDE
CREATE DATABASE IF NOT EXISTS AutoRideDB;
USE AutoRideDB;

-- 1. Bảng Khách hàng
CREATE TABLE KhachHang (
    MaKH VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    SoDienThoai VARCHAR(15) UNIQUE NOT NULL,
    Email VARCHAR(100) UNIQUE,
    SoGiaiPhepLaiXe VARCHAR(20) UNIQUE NOT NULL
);

-- 2. Bảng Xe
CREATE TABLE Xe (
    MaXe VARCHAR(10) PRIMARY KEY,
    BienSo VARCHAR(15) UNIQUE NOT NULL,
    TenXe VARCHAR(100) NOT NULL,
    LoaiXe VARCHAR(50),
    GiaThueTheoGio DECIMAL(10, 2) NOT NULL,
    TrangThai VARCHAR(30) DEFAULT 'Sẵn sàng'
);

-- 3. Bảng Chuyến đi / Đơn thuê xe
CREATE TABLE ChuyenDi (
    MaChuyen INT AUTO_INCREMENT PRIMARY KEY,
    MaKH VARCHAR(10),
    MaXe VARCHAR(10),
    ThoiGianBatDau DATETIME NOT NULL,
    ThoiGianKetThuc DATETIME,
    TongTien DECIMAL(12, 2) DEFAULT 0,
    TrangThaiThanhToan VARCHAR(30) DEFAULT 'Chưa thanh toán',
    FOREIGN KEY (MaKH) REFERENCES KhachHang(MaKH),
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe)
);

-- 4. Bảng Bảo trì xe
CREATE TABLE BaoTri (
    MaBaoTri INT AUTO_INCREMENT PRIMARY KEY,
    MaXe VARCHAR(10),
    NgayBaoTri DATE NOT NULL,
    ChiPhi DECIMAL(10, 2),
    MoTa VARCHAR(255),
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe)
);

