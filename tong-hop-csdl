-- ============================================================
-- BÀI 1: Phòng Khám HealthSync
-- ============================================================
CREATE DATABASE IF NOT EXISTS HealthSync;
USE HealthSync;

CREATE TABLE BacSi (
    MaBS VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    ChuyenKhoa VARCHAR(100)
);

CREATE TABLE BenhNhan (
    MaBN VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    NgaySinh DATE
);

CREATE TABLE LichKham (
    MaLich INT AUTO_INCREMENT PRIMARY KEY,
    MaBS VARCHAR(10),
    MaBN VARCHAR(10),
    NgayKham DATETIME,
    FOREIGN KEY (MaBS) REFERENCES BacSi(MaBS),
    FOREIGN KEY (MaBN) REFERENCES BenhNhan(MaBN)
);


-- ============================================================
-- BÀI 2: Chuyển đổi ERD sang Mô hình Quan hệ
-- ============================================================
CREATE DATABASE IF NOT EXISTS ChuyenDoiERD;
USE ChuyenDoiERD;

CREATE TABLE PhongBan (
    MaPB VARCHAR(10) PRIMARY KEY,
    TenPB VARCHAR(100) NOT NULL
);

CREATE TABLE NhanVien (
    MaNV VARCHAR(10) PRIMARY KEY,
    HoTen VARCHAR(100) NOT NULL,
    MaPB VARCHAR(10),
    FOREIGN KEY (MaPB) REFERENCES PhongBan(MaPB)
);


-- ============================================================
-- BÀI 3: Xây dựng Cơ sở dữ liệu Quản lý bán hàng
-- ============================================================
CREATE DATABASE IF NOT EXISTS QuanLyBanHang;
USE QuanLyBanHang;

CREATE TABLE KhachHang (
    MaKH INT AUTO_INCREMENT PRIMARY KEY,
    TenKH VARCHAR(100) NOT NULL,
    Email VARCHAR(100) UNIQUE,
    SoDienThoai VARCHAR(15)
);

CREATE TABLE SanPham (
    MaSP INT AUTO_INCREMENT PRIMARY KEY,
    TenSP VARCHAR(150) NOT NULL,
    Gia DECIMAL(10, 2) NOT NULL
);

CREATE TABLE DonHang (
    MaDH INT AUTO_INCREMENT PRIMARY KEY,
    NgayDat DATETIME DEFAULT CURRENT_TIMESTAMP,
    MaKH INT,
    FOREIGN KEY (MaKH) REFERENCES KhachHang(MaKH)
);

CREATE TABLE ChiTietDonHang (
    MaDH INT,
    MaSP INT,
    SoLuong INT NOT NULL,
    PRIMARY KEY (MaDH, MaSP),
    FOREIGN KEY (MaDH) REFERENCES DonHang(MaDH),
    FOREIGN KEY (MaSP) REFERENCES SanPham(MaSP)
);


-- ============================================================
-- BÀI 4: Sự cố AutoRide - Khớp dữ liệu với quy trình
-- ============================================================
CREATE DATABASE IF NOT EXISTS AutoRide;
USE AutoRide;

CREATE TABLE Xe (
    MaXe VARCHAR(10) PRIMARY KEY,
    BienSo VARCHAR(20) UNIQUE NOT NULL,
    TrangThai VARCHAR(50) DEFAULT 'San sang'
);

CREATE TABLE ChuyenDi (
    MaChuyen INT AUTO_INCREMENT PRIMARY KEY,
    MaXe VARCHAR(10),
    GiaChuyen DECIMAL(10, 2) NOT NULL,
    ThoiGianBatDau DATETIME,
    ThoiGianKetThuc DATETIME,
    FOREIGN KEY (MaXe) REFERENCES Xe(MaXe)
);
