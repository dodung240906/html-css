-- HỆ THỐNG PAYFLOW - TỐI ƯU HÓA HIỆU NĂNG TRUY VẤN
CREATE DATABASE IF NOT EXISTS payflow_db;
USE payflow_db;

-- 1. Tạo bảng Transactions
DROP TABLE IF EXISTS Transactions;
CREATE TABLE Transactions (
    transaction_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    amount DECIMAL(15,2),
    transaction_type VARCHAR(20), -- 'DEPOSIT', 'WITHDRAW', 'TRANSFER'
    created_at DATETIME
);

-- 2. Tạo Composite Index tối ưu theo chuẩn SARGable
-- Đặt transaction_type lên trước (độ chọn lọc/độ bằng cao), created_at phía sau (phục vụ lọc khoảng Range)
CREATE INDEX idx_type_date ON Transactions(transaction_type, created_at);

-- ========================================================
-- TRUY VẤN CŨ (GÂY SẬP HỆ THỐNG - NON-SARGABLE)
-- ========================================================
-- Lỗi: Hàm YEAR() và MONTH() bọc quanh cột created_at làm hỏng cơ chế B-Tree Index
-- EXPLAIN SELECT SUM(amount) AS total_deposit
-- FROM Transactions
-- WHERE transaction_type = 'DEPOSIT' 
--   AND YEAR(created_at) = 2026 
--   AND MONTH(created_at) = 6;

-- ========================================================
-- TRUY VẤN MỚI (ĐÃ TỐI ƯU - SARGABLE RANGE QUERY)
-- ========================================================
EXPLAIN 
SELECT SUM(amount) AS total_deposit
FROM Transactions
WHERE transaction_type = 'DEPOSIT' 
  AND created_at >= '2026-06-01 00:00:00' 
  AND created_at < '2026-07-01 00:00:00';
